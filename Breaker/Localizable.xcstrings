{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ · %@" : {
      "comment" : "Sidebar: the kind of item, then its status or reason, e.g. User Agent · Exit code 1 (tooltip) or launchd · Exit code 1 (Needs Attention section)",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ (%@)" : {
      "comment" : "Text followed by a parenthetical, e.g. Failed (Exit code 1) or Folder not found (it may not be mounted)",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@（%2$@）"
          }
        }
      }
    },
    "%@ (PID %d)" : {
      "comment" : "Status of a running launchd job followed by its process ID",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (PID %2$d)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@（PID %2$d）"
          }
        }
      }
    },
    "%@ %lld" : {
      "comment" : "Month and day of a schedule, e.g. Jan 1",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$lld"
