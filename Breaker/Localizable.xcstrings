{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ · %@" : {
      "comment" : "Sidebar: the kind of item, then its status or reason, e.g. User Agent · Exit code 1 (tooltip) or launchd · Exit code 1 (Needs Attention section)",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ (%@)" : {
      "comment" : "Text followed by a parenthetical, e.g. Failed (Exit code 1) or Folder not found (it may not be mounted)",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@（%2$@）"
          }
        }
      }
    },
    "%@ (PID %@)" : {
      "comment" : "Status of a running launchd job followed by its process ID",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (PID %2$@)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@（PID %2$@）"
          }
        }
      }
    },
    "%@ %lld" : {
      "comment" : "Month and day of a schedule, e.g. Jan 1",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$lld"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@%2$lld日"
          }
        }
      }
    },
    "%@ at %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ at %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ didn't finish in time" : {
      "comment" : "Error when an external command was stopped because it took too long. The placeholder is the command path",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ が時間内に終わりませんでした"
          }
        }
      }
    },
    "%@ free" : {
      "comment" : "Sidebar: free space of the startup disk, e.g. 38 GB free",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空き %@"
          }
        }
      }
    },
    "%@ in %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ in %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@の%1$@"
          }
        }
      }
    },
    "%@ keeps using the CPU" : {
      "comment" : "Reason of the system load item when one app or process has used a lot of CPU for a while, e.g. Xcode keeps using the CPU",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ が CPU を使い続けています"
          }
        }
      }
    },
    "%@ loss" : {
      "comment" : "Packet loss rate of pings, e.g. 0% loss",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロス %@"
          }
        }
      }
    },
    "%@ will be stopped with launchctl disable and bootout. It stays stopped after you log in again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ will be stopped with launchctl disable and bootout. It stays stopped after you log in again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を launchctl disable と bootout で止めます。ログインし直しても止まったままです。"
          }
        }
      }
    },
    "%@, every hour at minute %lld" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, every hour at minute %2$lld"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 毎時%2$lld分"
          }
        }
      }
    },
    "%@, every hour from %@ to %@" : {
      "comment" : "Text for a schedule entry that specifies a time range. The second argument is the string “%1$d:%2$02d”. The third argument is the string “%1$d:%2$02d”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, every hour from %2$@ to %3$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@〜%3$@ の毎時"
          }
        }
      }
    },
    "%@, every minute" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, every minute"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 毎分"
          }
        }
