    "Breaker keeps running after you close its window, so it can notify you when something breaks." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breaker keeps running after you close its window, so it can notify you when something breaks."
