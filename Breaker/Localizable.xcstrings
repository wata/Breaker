    "%@ will be stopped with launchctl disable and bootout. It stays stopped after you log in again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ will be stopped with launchctl disable and bootout. It stays stopped after you log in again."
