        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld件の異常があります"
          }
        }
      }
    },
    "%lld runs since loaded" : {
      "comment" : "Number of times a launchd job has run since launchd loaded it",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld run since loaded"
